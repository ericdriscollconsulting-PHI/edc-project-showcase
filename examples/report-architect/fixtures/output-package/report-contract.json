  "anomalyManagement": {
    "breachAcrossBaselines": "any",
    "materiality": {
      "amount": {
        "currency": "USD",
        "metric": "variance-amount",
        "operator": ">=",
        "value": 20000
      },
      "combination": "either",
      "method": "both",
      "percentage": {
        "metric": "variance-percent",
        "operator": ">=",
        "value": 10
      }
    },
    "response": {
      "action": "approve-corrective-action"
    }
  },
  "assumptions": [
    "The MVP is restricted to AWS provider data by an explicit cloud-provider filter",
    "Tenant dimension and metric bindings must be confirmed before query execution or manual construction",
    "Saved-report creation remains manual until a supported mutation API is verified",
    "Budget reference data must be supplied and its grain and currency validated before execution",
    "Forecast reference data must be supplied and its grain and currency validated before execution",
    "Alert configuration is a manual requirement; this package performs no alert writes or delivery integrations",
    "Additional data must be supplied and its ownership, grain, join keys, and freshness validated before execution"
  ],
  "businessQuestions": [
    "How much amortized AWS cost was incurred in the selected period, and what is driving it?",
    "How does current amortized AWS cost compare independently with each selected baseline?",
    "Which AWS cost changes meet the defined materiality rules, and what response is required?",
    "Which cost center owns the spend and resulting follow-up?"
  ],
  "calculationRules": {
    "baselines": [
      {
        "alignmentPolicy": "direct-join",
        "baseline": "prior-period",
        "comparisonCostMetric": "prior-period-cost",
        "joinKeys": [
          "cost-center",
          "application",
          "cloud-provider"
        ],
        "varianceAmountFormula": "current-cost - baseline-cost",
        "varianceAmountMetric": "prior-period-variance-amount",
        "variancePercentFormula": "variance-amount / baseline-cost * 100",
        "variancePercentMetric": "prior-period-variance-percent",
        "zeroBaselinePolicy": "flag-new-spend-and-suppress-percent"
      },
      {
        "alignmentPolicy": "aggregate-current-to-baseline-grain",
        "baseline": "budget",
        "comparisonCostMetric": "budget-cost",
        "joinKeys": [
          "cost-center"
        ],
        "varianceAmountFormula": "current-cost - baseline-cost",
        "varianceAmountMetric": "budget-variance-amount",
        "variancePercentFormula": "variance-amount / baseline-cost * 100",
        "variancePercentMetric": "budget-variance-percent",
        "zeroBaselinePolicy": "flag-new-spend-and-suppress-percent"
      },
      {
        "alignmentPolicy": "aggregate-current-to-baseline-grain",
        "baseline": "forecast",
        "comparisonCostMetric": "forecast-cost",
        "joinKeys": [
          "cost-center"
        ],
        "varianceAmountFormula": "current-cost - baseline-cost",
        "varianceAmountMetric": "forecast-variance-amount",
        "variancePercentFormula": "variance-amount / baseline-cost * 100",
        "variancePercentMetric": "forecast-variance-percent",
        "zeroBaselinePolicy": "flag-new-spend-and-suppress-percent"
      }
    ],
    "currentGroupBy": [
      "cost-center",
      "application",
      "cloud-provider",
      "reporting-period"
    ]
  },
  "comparisons": [
    {
      "mode": "same-elapsed-period",
      "type": "prior-period"
    },
    {
      "currency": "USD",
      "grain": "accountability-dimension",
      "period": "fiscal-month",
      "sourceRef": "Finance Approved Budget",
